7D20  C7460880FF        00191 	MOV WORD [BP+BALL_YS],0XFF80	; Update Y speed for ball
7D25  B9970A            00192 	MOV CX,2711		; 1193180 / 440
7D28  E86B00            00193 	CALL SPEAKER		; Generate sound
7D2B  5B                00194 	POP BX
7D2C  58                00195 	POP AX
7D2D  EBAD              00196 	JMP .14
